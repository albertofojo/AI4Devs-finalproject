# ===== XANEE Backend — variables de entorno =====
# Copia este fichero a .env y rellena los valores reales (nunca commitear .env).

# --- Base de datos ---
# En producción: cadena de conexión de Supabase Postgres.
# En local/test puedes usar SQLite: sqlite:///./xanee_dev.db
DATABASE_URL=sqlite:///./xanee_dev.db

# --- Supabase ---
SUPABASE_URL=https://<tu-proyecto>.supabase.co
SUPABASE_ANON_KEY=<anon-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>   # solo backend, para Storage/admin
# Secreto para verificar los JWT HS256 (legacy y usado en tests). Los proyectos
# Supabase nuevos firman los access tokens con ES256 (claves asimétricas) y el
# backend los verifica automáticamente vía el JWKS del proyecto
# ({SUPABASE_URL}/auth/v1/.well-known/jwks.json); este secreto solo se usa si el
# token viene en HS256. Dashboard > Project Settings > API > JWT Secret.
SUPABASE_JWT_SECRET=<jwt-secret>
SUPABASE_STORAGE_BUCKET=scores

# --- App ---
# CORS: orígenes permitidos del frontend (coma-separados).
CORS_ORIGINS=http://localhost:8080,http://localhost:5000
# Modo de entorno: development | test | production
ENVIRONMENT=development
